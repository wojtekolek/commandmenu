---
import Footer from "../components/Footer.astro";
import { TopMenu } from "../components/TopMenu";
import "../styles/globals.css";

type Props = {
  title: string;
  description: string;
};
const { title, description } = Astro.props;
const canonicalUrl = Astro.url.href;
const siteName = "Command Menu";
---

<html lang="en" class="bg-primary-50 font-default text-primary-950 antialiased">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- The wordmark is the first thing painted; don't let its font be the last thing fetched. -->
		<link rel="preload" href="/fonts/rhallisa/Rhallisa.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/opensauceone/OpenSauceOne-Regular.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#f4f4f4" />

		<!-- SEO -->
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/og.png" />
		<meta property="og:site_name" content={siteName} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="/og.png" />
	</head>
	<body id="top" class="flex min-h-svh flex-col overflow-x-clip 2xl:mx-auto 2xl:max-w-[1440px]">
		<TopMenu client:load />

		<main class="flex-1 pt-20">
			<slot />
		</main>

		<Footer />
	</body>
</html>
